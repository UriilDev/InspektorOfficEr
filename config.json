{
  "paths": {
    "reportsDir": "Raports",
    "passportsDir": "Passports",
    "workbook": ""
  },
  "features": {
    "report": true,
    "excel": true,
    "anyDesk": true,
    "hopToDesk": true,
    "hopToDeskCli": true,
    "freezeDetect": true,
    "anyDeskCli": true
  },
  "passport": {
    "askIfMissing": true,
    "roomsPerFloor": {
      "1": 10,
      "2": 10
    }
  },
  "excel": {
    "sheetName": "Заморозка",
    "headers": [
      "#",
      "Этаж",
      "Помещение",
      "Рабочее место",
      "Пользователь",
      "Anydesk",
      "HopToDesk",
      "Состояние рабочей станции",
      "Состояние заморозки",
      "Имя ПК",
      "Отчёт"
    ],
    "defaultState": "Хорошее",
    "reportLabel": "Отчёт",
    "labelDateFormat": "yyyy-MM-dd"
  },
  "freeze": {
    "enabledText": "Включено",
    "disableBuiltin": [],
    "extraProducts": [],
    "excludePattern": ""
  },
  "anyDesk": {
    "extraConfigDirs": [],
    "extraPaths": []
  },
  "hopToDesk": {
    "extraPaths": []
  },
  "checks": {
    "uptimeDaysWarn": 30,
    "ramGbWarn": 4,
    "diskFreePctWarn": 20,
    "diskFreePctBad": 10,
    "diskFreeGbBad": 5,
    "osSupportWarnDays": 90,
    "changeFreeGb": 5,
    "osSupport": []
  },
  "reports": {
    "fileName": "{pc}_report_{date}.html",
    "dateFormat": "yyyyMMdd"
  },
  "backup": {
    "keep": 10
  },
  "log": {
    "level": "INFO"
  },
  "timeouts": {
    "hopToDeskCliSec": 8,
    "robocopySec": 30,
    "anyDeskCliSec": 8
  },
  "ui": {
    "openReportWhenDone": true,
    "openFolderWhenDone": false
  }
}
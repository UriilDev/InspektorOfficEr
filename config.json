{
  "paths": {
    "reportsDir": "Raports",
    "passportsDir": "Passports",
    "workbook": ""
  },
  "features": {
    "hardwareCollector": true,
    "excel": true,
    "remoteAccessDetect": true,
    "remoteAccessCli": true,
    "diskProtectionDetect": true
  },
  "passport": {
    "askIfMissing": true,
    "roomsPerFloor": {
      "1": 10,
      "2": 10
    }
  },
  "excel": {
    "sheetName": "Инвентаризация",
    "headers": [
      "#",
      "Этаж",
      "Помещение",
      "Рабочее место",
      "Пользователь",
      "Удалённый доступ 1 (ID)",
      "Удалённый доступ 2 (ID)",
      "Состояние рабочей станции",
      "Защита диска",
      "Имя ПК",
      "Отчёт"
    ],
    "defaultState": "Хорошее",
    "reportLabel": "Отчёт",
    "labelDateFormat": "yyyy-MM-dd"
  },
  "remoteAccessDetect": {
    "extraConfigDirsA": [],
    "extraPathsA": [],
    "extraPathsB": []
  },
  "diskProtectionDetect": {
    "enabledText": "Включено",
    "disableBuiltin": [],
    "extraProducts": [],
    "excludePattern": ""
  },
  "checks": {
    "uptimeDaysWarn": 30,
    "ramGbWarn": 4,
    "diskFreePctWarn": 20,
    "diskFreePctBad": 10,
    "diskFreeGbBad": 5,
    "osSupportWarnDays": 90,
    "changeFreeGb": 5,
    "osSupport": []
  },
  "reports": {
    "fileName": "{pc}_report_{date}.html",
    "dateFormat": "yyyyMMdd"
  },
  "backup": {
    "keep": 10
  },
  "log": {
    "level": "INFO"
  },
  "ui": {
    "openReportWhenDone": true,
    "openFolderWhenDone": false
  },
  "timeouts": {
    "remoteCliSec": 8,
    "robocopySec": 30
  }
}